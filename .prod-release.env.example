# Copy to .prod-release.env on the deployment host (it is intentionally ignored).
# This is the directory containing the production docker-compose.yml and .env.
# Its immich-server image must be: ${IMMICH_SERVER_IMAGE:-immich-server:latest}
# The release script selects the commit image for deployment and updates the
# deployment .env after verification. The release user needs write access to
# this file; the deployment directory may remain root-owned and read-only.
export IMMICH_DEPLOY_DIR=/absolute/path/to/immich-production
export IMMICH_HEALTH_URL=https://your-immich-host/api/server/ping
# Set only when the configured endpoint intentionally uses a self-signed TLS certificate.
export IMMICH_HEALTH_INSECURE_TLS=false
# Set to the protected branch that this release script may deploy.
export IMMICH_PROD_BRANCH=merge/immich-v3.2.0
export IMMICH_PROD_REMOTE=origin
# Optional: export IMMICH_GITHUB_DEV_PAT in the invoking environment to use a
# GitHub personal access token for fetch, push, and remote verification.
# Keep the token out of this file and Git remote URLs.
# Optional: an absolute directory for verified pg_dump archives.
export IMMICH_BACKUP_DIR=/absolute/path/to/immich-production-backups
